APP_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-staging-key-for-user-setup-only
EXPRESSJOBS_ALLOW_STAGING_MUTATIONS=false
EXPRESSJOBS_STAGING_CLIENT_EMAIL=client-staging@example.com
EXPRESSJOBS_STAGING_CLIENT_PASSWORD=replace-locally-never-commit
EXPRESSJOBS_STAGING_WORKER_EMAIL=worker-staging@example.com
EXPRESSJOBS_STAGING_WORKER_PASSWORD=replace-locally-never-commit
EXPRESSJOBS_STAGING_ADMIN_EMAIL=admin-staging@example.com
EXPRESSJOBS_STAGING_ADMIN_PASSWORD=replace-locally-never-commit
