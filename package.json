{
  "name": "expressjobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls:static": "vitest run src/__tests__/supabase-rls-static.test.ts",
    "staging:check": "node scripts/expressjobs-staging-check.mjs",
    "production:check": "node scripts/expressjobs-production-check.mjs",
    "guard:no-production-deploy": "node scripts/assert-no-production-deploy.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "rls:smoke": "node scripts/expressjobs-rls-smoke.mjs",
    "rls:create-staging-users": "node scripts/expressjobs-create-staging-users.mjs",
    "rls:bootstrap-anon-users": "node scripts/expressjobs-bootstrap-staging-users-with-anon.mjs",
    "paypal:sandbox:smoke": "node scripts/paypal-sandbox-smoke.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run secret:scan"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.104.1",
    "lucide-react": "^0.555.0",
    "next": "^16.2.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
